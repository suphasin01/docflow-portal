rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // บัญชีชุดแรกเป็น bootstrap admin เพื่อให้มีผู้อนุมัติคำขอใหม่เสมอ
    function isBootstrapAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && (
          request.auth.token.email == "siriflowerland@gmail.com"
          || request.auth.token.email == "saksitpz1011@gmail.com"
          || request.auth.token.email == "invpmr936@gmail.com"
          || request.auth.token.email == "beyonddevtechsolution@gmail.com"
        );
    }

    function isVerifiedGoogleUser() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.firebase.sign_in_provider == "google.com";
    }

    function hasApprovedAccess() {
      return isVerifiedGoogleUser()
        && (
          isBootstrapAdmin()
          || (
            exists(/databases/$(database)/documents/accessControl/$(request.auth.uid))
            && get(/databases/$(database)/documents/accessControl/$(request.auth.uid)).data.status == "approved"
          )
        );
    }

    // Every approved member is an equal workspace owner, including user management.
    function isAdmin() {
      return hasApprovedAccess();
    }

    // ผู้ใช้ใหม่สร้างคำขอได้ด้วยบัญชีตัวเองเท่านั้น ผู้ดูแลเป็นคนอนุมัติ/ปฏิเสธ
    match /accessRequests/{userId} {
      allow get: if isVerifiedGoogleUser()
        && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow create: if isAdmin() || (isVerifiedGoogleUser()
        && request.auth.uid == userId
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.status == "pending");
      allow update: if isAdmin()
        || (
          isVerifiedGoogleUser()
          && request.auth.uid == userId
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.email == request.auth.token.email
          && request.resource.data.status == "pending"
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "displayName", "photoURL", "status", "requestedAt", "updatedAt"
          ])
        );
      allow delete: if isAdmin();
    }

    // เอกสารสิทธิ์เขียนได้เฉพาะผู้ดูแล เจ้าของบัญชีอ่านสถานะตัวเองได้
    match /accessControl/{userId} {
      allow get: if isVerifiedGoogleUser()
        && (request.auth.uid == userId || isAdmin());
      allow list, create, update, delete: if isAdmin();
    }

    // Public workspace routing ID; keep in sync with src/config/workspace.ts.
    function ownsCompany(companyId) {
      return hasApprovedAccess() && companyId == "KOrKa4F8fvCihChq8O8t";
    }

    function preservesWorkspaceAndAuthor() {
      return ownsCompany(resource.data.companyId)
        && request.resource.data.companyId == resource.data.companyId
        && !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(["createdBy", "createdAt"]);
    }

    // ── Users ──
    match /users/{userId} {
      allow read: if hasApprovedAccess() && request.auth.uid == userId;
      allow write: if hasApprovedAccess() && request.auth.uid == userId;
    }

    // One existing company. No client may create, archive or retarget it.
    match /companies/{companyId} {
      allow read: if ownsCompany(companyId);
      allow create, delete: if false;
      allow update: if ownsCompany(companyId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "name", "nameEn", "officeType", "taxId", "branch", "branchName",
          "branchCode", "address", "phone", "email", "logoUrl",
          "signerName", "signerPosition", "updatedAt"
        ]);
    }

    // ── Settings (per company) ──
    match /settings/{companyId} {
      allow read, write: if ownsCompany(companyId);
    }

    // ── Documents ──
    match /documents/{docId} {
      allow read: if hasApprovedAccess()
        && ownsCompany(resource.data.companyId);
      allow create: if hasApprovedAccess()
        && request.resource.data.keys().hasAll(['companyId','createdAt','updatedAt','createdBy'])
        && ownsCompany(request.resource.data.companyId)
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if preservesWorkspaceAndAuthor();
      allow delete: if hasApprovedAccess()
        && ownsCompany(resource.data.companyId);
    }

    // ── Products ──
    match /products/{docId} {
      allow read: if hasApprovedAccess()
        && ownsCompany(resource.data.companyId);
      allow create: if hasApprovedAccess()
        && ownsCompany(request.resource.data.companyId)
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if preservesWorkspaceAndAuthor();
      allow delete: if false;
    }

    // ── Customers ──
    match /customers/{docId} {
      allow read: if hasApprovedAccess()
        && ownsCompany(resource.data.companyId);
      allow create: if hasApprovedAccess()
        && ownsCompany(request.resource.data.companyId)
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if preservesWorkspaceAndAuthor();
      allow delete: if false;
    }

    // ── Vendors ──
    match /vendors/{docId} {
      allow read: if hasApprovedAccess()
        && ownsCompany(resource.data.companyId);
      allow create: if hasApprovedAccess()
        && ownsCompany(request.resource.data.companyId)
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if preservesWorkspaceAndAuthor();
      allow delete: if false;
    }

    // ── Payments ──
    match /payments/{docId} {
      allow read: if hasApprovedAccess()
        && ownsCompany(resource.data.companyId);
      allow create: if hasApprovedAccess()
        && ownsCompany(request.resource.data.companyId)
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if preservesWorkspaceAndAuthor();
      allow delete: if false;
    }

    // Legacy line items share the same workspace boundary.
    match /documentItems/{docId} {
      allow read: if ownsCompany(resource.data.companyId);
      allow create: if ownsCompany(request.resource.data.companyId)
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if preservesWorkspaceAndAuthor();
      allow delete: if ownsCompany(resource.data.companyId);
    }

    // ── Contacts (ลูกค้า/ผู้ขาย unified) ──
    match /contacts/{docId} {
      allow read: if hasApprovedAccess()
        && ownsCompany(resource.data.companyId);
      allow create: if hasApprovedAccess()
        && ownsCompany(request.resource.data.companyId)
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if preservesWorkspaceAndAuthor();
      allow delete: if false;
    }
  }
}
